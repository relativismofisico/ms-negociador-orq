# Cuenta de servicio de ms-liquidador-neg (Basic Auth). SOLO nombres: nunca valores reales en el repo.
# Copiar a .env (ignorado por git) o definirlas en el IDE / en el entorno del despliegue.
# Obligatorias: sin ellas, o si el hash no tiene formato bcrypt, el servicio no arranca.
LIQUIDADOR_SERVICE_USERNAME=
LIQUIDADOR_SERVICE_PASSWORD_HASH=
