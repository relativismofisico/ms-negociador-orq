# Variables de entorno de la base de datos (ms-security-util#52). SOLO nombres: nunca valores reales en el repo.
# Copiar a .env (ignorado por git) o definirlas en el IDE / en el entorno del despliegue.
# Obligatorias: si falta alguna o está vacía, el servicio no arranca y el error nombra la variable.
# DB_URL es la URL JDBC completa (host, puerto, base y parámetros); en qa/prod con useSSL=true&requireSSL=true.
DB_URL=
DB_PASSWORD=
DB_USER=
# Opcionales (tienen un valor por defecto no sensible en application.yml):
# DB_POOL_SIZE=

# Cuenta de servicio de ms-liquidador-neg (Basic Auth). SOLO nombres: nunca valores reales en el repo.
# Copiar a .env (ignorado por git) o definirlas en el IDE / en el entorno del despliegue.
# Obligatorias: sin ellas, o si el hash no tiene formato bcrypt, el servicio no arranca.
LIQUIDADOR_SERVICE_USERNAME=
LIQUIDADOR_SERVICE_PASSWORD_HASH=
