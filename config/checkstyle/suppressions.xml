<?xml version="1.0"?>
<!DOCTYPE suppressions PUBLIC
    "-//Checkstyle//DTD SuppressionList Configuration 1.2//EN"
    "https://checkstyle.org/dtds/suppressions_1_2.dtd">

<!--
  Supresiones específicas de Checkstyle.
  Documenta cada supresión con justificación técnica.
-->
<suppressions>

    <!--
      PdfFirmaService: declarado como import de dependencia transitiva
      intencional. Se mantiene para facilitar el acceso directo si la
      arquitectura lo requiere en el futuro.
    -->
    <suppress checks="UnusedImports"
              files="AprobacionEndosoDescuentoServiceImpl\.java"
              message="PdfFirmaService"/>

    <!--
      Spring Data JPA usa underscore para navegar propiedades anidadas
      en query methods derivados (ej: findByUser_IdeUser -> User.ideUser).
      No es posible renombrar sin romper la query derivada de JPA.
    -->
    <suppress checks="MethodName"
              files="UserQuotaRepository\.java"/>

    <!--
      Clases de tests: relajamos algunas reglas de nomenclatura y
      visibilidad que son estándar en frameworks de prueba.
    -->
    <suppress checks="VisibilityModifier"
              files=".*Test\.java"/>

    <!--
      Nombres de métodos de test usan guion bajo para separar
      escenario_resultado (estilo BDD). Es el patrón estándar en JUnit 5.
    -->
    <suppress checks="MethodName"
              files=".*Test\.java"/>

</suppressions>